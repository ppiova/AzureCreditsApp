<?xml version="1.0" encoding="utf-8"?>
<!--
  Identity Name is a placeholder until the app name is reserved in Partner Center
  (issue #21): copy Name from Partner Center > Product identity. Publisher is the
  same Partner Center account as Cloud VM Manager, and the Store workflow
  overrides it from the MSIX_PUBLISHER secret when set.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="PablitoPiova.CloudCreditsManager"
    Publisher="CN=9C5245CA-C92C-4BF3-8E4D-810F66F8811F"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Cloud Credits Manager</DisplayName>
    <PublisherDisplayName>Pablito Piova</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Cloud Credits Manager"
        Description="Track Azure credits, subscriptions and budget alerts across your Microsoft accounts."
        BackgroundColor="#2563EB"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#2563EB" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
