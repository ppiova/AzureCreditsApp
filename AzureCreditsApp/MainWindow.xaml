<Window x:Class="AzureCreditsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:AzureCreditsApp.Models"
        mc:Ignorable="d"
        Title="Cloud Credits Manager" Height="800" Width="1360"
        MinHeight="600" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Segoe UI"
        Icon="/AzureCreditsApp;component/Assets/AppIcon.ico">
    <Window.Resources>
        <!-- Colours a status text by the credit's Severity. -->
        <Style x:Key="SeverityTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:Severity.Good}">
                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:Severity.Warning}">
                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="{x:Static models:Severity.Danger}">
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>

        <Style x:Key="DetailValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="SecondaryLineStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Cloud Credits Manager" FontSize="30" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Track Azure credits and subscriptions across your Microsoft accounts without opening the Azure portal."
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="14"
                           Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Add account"
                        Margin="0,0,8,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddAccountCommand}" />
                <Button Content="Refresh"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
        </DockPanel>

        <!-- Accounts -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,0,0,14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Text="Accounts"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="4,0,12,0" />
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding LastUpdated}"
                           Foreground="{StaticResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,4,0" />
                <Grid>
                    <ItemsControl ItemsSource="{Binding Accounts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F1F5F9"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Padding="12,3,4,3"
                                        Margin="0,2,8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Username}" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Button Content="Sign in again"
                                                Margin="8,0,0,0"
                                                Style="{StaticResource LinkButtonStyle}"
                                                Visibility="{Binding NeedsSignIn, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Command="{Binding DataContext.SignInAgainCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="✕"
                                                ToolTip="Remove this account from the app"
                                                Margin="4,0,0,0"
                                                Style="{StaticResource ChipButtonStyle}"
                                                Command="{Binding DataContext.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No accounts signed in."
                               Foreground="{StaticResource TextSubtleBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasNoAccounts, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- Summary -->
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,14">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="CREDIT REMAINING" Style="{StaticResource DashboardLabelStyle}" />
                    <TextBlock Text="{Binding TotalCreditRemaining}" Style="{StaticResource DashboardValueStyle}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="SUBSCRIPTIONS" Style="{StaticResource DashboardLabelStyle}" />
                    <TextBlock Text="{Binding SubscriptionCount}" Style="{StaticResource DashboardValueStyle}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="NEED ATTENTION" Style="{StaticResource DashboardLabelStyle}" />
                    <TextBlock Text="{Binding AttentionCount}" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DashboardValueStyle}">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AttentionCount}" Value="0">
                                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Subscriptions and details -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,14,0">
              <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="16,12,16,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HiddenDisplay}"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"
                                   Visibility="{Binding HasHidden, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <CheckBox Content="Hide not tracked"
                                  IsChecked="{Binding HideNotTracked}"
                                  VerticalAlignment="Center"
                                  Foreground="{StaticResource TextSecondaryBrush}"
                                  ToolTip="Hide subscriptions billed to an organization (Microsoft internal, Enterprise Agreement, CSP)." />
                    </StackPanel>
                    <TextBlock Text="Subscriptions" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <Grid>
                    <DataGrid ItemsSource="{Binding Subscriptions}"
                              SelectedItem="{Binding SelectedSubscription}"
                              SelectionMode="Single"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              RowHeaderWidth="0"
                              Background="White"
                              BorderThickness="0"
                              AlternatingRowBackground="#F8FAFC"
                              RowBackground="White"
                              Margin="1,1,1,8">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC" />
                                <Setter Property="Foreground" Value="#475569" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="12,10" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="#E2E8F0" />
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="12,8" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Foreground" Value="#0F172A" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF" />
                                        <Setter Property="Foreground" Value="#0F172A" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Subscription" Width="2.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding AccountName}" Style="{StaticResource SecondaryLineStyle}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Offer" Width="1.3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding OfferDisplay}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Credit remaining" Width="1.6*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding RemainingDisplay}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding OriginalDisplay}" Style="{StaticResource SecondaryLineStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Used" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding UsedDisplay}" />
                                            <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}"
                                                         Maximum="100"
                                                         Height="5"
                                                         Margin="0,4,0,0"
                                                         Foreground="{StaticResource AccentBrush}"
                                                         Background="{StaticResource BorderBrush}"
                                                         BorderThickness="0"
                                                         Visibility="{Binding HasUsage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="This month" Width="1.4*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding PeriodCostDisplay}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ProjectedDisplay}" Style="{StaticResource SecondaryLineStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Expires / resets" Width="1.3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DueDateDisplay}" />
                                            <TextBlock Text="{Binding DueHint}" Style="{StaticResource SecondaryLineStyle}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Status" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource SeverityTextStyle}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="0,40,0,0"
                                Visibility="{Binding ShowEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{Binding EmptyStateTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyStateMessage}"
                                   Foreground="{StaticResource TextSubtleBrush}"
                                   Margin="0,6,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
              </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Border Style="{StaticResource CardStyle}"
                            VerticalAlignment="Top"
                            Visibility="{Binding HasSelection, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <TextBlock Text="Select a subscription to see its credit and cost details."
                                   Foreground="{StaticResource TextMutedBrush}"
                                   TextWrapping="Wrap" />
                    </Border>

                    <StackPanel DataContext="{Binding SelectedSubscription}"
                                Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <!-- Credit -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="CREDIT" Style="{StaticResource DashboardLabelStyle}" />
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,6,0,4" />
                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource SeverityTextStyle}" FontSize="14" />
                                <TextBlock Text="{Binding Note}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />

                                <WrapPanel Visibility="{Binding HasRemaining, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding RemainingDisplay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding OriginalDisplay}" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="8,0,0,4" />
                                </WrapPanel>
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           Visibility="{Binding HasDueDate, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Run Text="{Binding DueLabel, Mode=OneWay}" />
                                    <Run Text="{Binding DueDateDisplay, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="·" Foreground="{StaticResource TextSubtleBrush}" />
                                    <Run Text="{Binding DueHint, Mode=OneWay}" />
                                </TextBlock>

                                <!-- Credit lots (billing profile credits) -->
                                <StackPanel Margin="0,14,0,0" Visibility="{Binding HasLots, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Credit lots" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <ItemsControl ItemsSource="{Binding Lots}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Source}" Foreground="{StaticResource TextPrimaryBrush}" />
                                                        <TextBlock Text="{Binding AmountDisplay}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                                        <TextBlock Text="{Binding PeriodDisplay}" Style="{StaticResource SecondaryLineStyle}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Lot balances are as of the last invoice."
                                               Style="{StaticResource SecondaryLineStyle}"
                                               Margin="0,6,0,0" />
                                </StackPanel>

                                <!-- Monthly credit (Visual Studio, partner network) -->
                                <StackPanel Margin="0,14,0,0" Visibility="{Binding UsesMonthlyCredit, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="Monthly credit" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding DataContext.MonthlyCreditAmount, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Monthly credit amount, in the currency the subscription is billed in"
                                                 Padding="8,5"
                                                 BorderBrush="{StaticResource InputBorderBrush}"
                                                 VerticalContentAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding DataContext.MonthlyCreditCurrency, RelativeSource={RelativeSource AncestorType=Window}, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Currency code, for example USD or ARS"
                                                 Margin="8,0,0,0"
                                                 Padding="8,5"
                                                 CharacterCasing="Upper"
                                                 MaxLength="3"
                                                 BorderBrush="{StaticResource InputBorderBrush}"
                                                 VerticalContentAlignment="Center" />
                                        <Button Grid.Column="2"
                                                Content="Save"
                                                Margin="8,0,0,0"
                                                Padding="12,5"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.SaveMonthlyCreditCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </Grid>
                                    <TextBlock Text="Visual Studio Enterprise includes USD 150 a month. Enter it in the currency your costs are billed in; the portal shows the full amount on the day the credit resets."
                                               Style="{StaticResource SecondaryLineStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Cost -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="COST" Style="{StaticResource DashboardLabelStyle}" />
                                <DockPanel Margin="0,8,0,4">
                                    <TextBlock Text="{Binding PeriodCostDisplay}" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding PeriodCostLabel}" Foreground="{StaticResource TextSecondaryBrush}" />
                                </DockPanel>
                                <TextBlock Text="{Binding ProjectedDisplay}"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Right"
                                           Visibility="{Binding HasProjection, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <DockPanel Margin="0,6,0,10" Visibility="{Binding HasAverage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding AverageDisplay}" DockPanel.Dock="Right" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="Monthly average" Foreground="{StaticResource TextSecondaryBrush}" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding MonthlyCosts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="{Binding AmountDisplay}" DockPanel.Dock="Right" Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding MonthDisplay}" Foreground="{StaticResource TextMutedBrush}" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding CostError}"
                                           Foreground="{StaticResource WarningBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0"
                                           Visibility="{Binding HasCostError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <TextBlock Text="Actual cost before credits, from Cost Management."
                                           Style="{StaticResource SecondaryLineStyle}"
                                           Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Subscription -->
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="SUBSCRIPTION" Style="{StaticResource DashboardLabelStyle}" />
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Account" Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AccountName}" Style="{StaticResource DetailValueStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Directory" Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Subscription.TenantName}" Style="{StaticResource DetailValueStyle}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="ID" Style="{StaticResource DetailLabelStyle}" />
                                    <TextBox Grid.Row="2" Grid.Column="1"
                                             Text="{Binding Subscription.Id, Mode=OneWay}"
                                             IsReadOnly="True"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="0"
                                             Margin="-2,0,0,8"
                                             TextWrapping="Wrap"
                                             Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Offer" Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OfferDisplay}" Style="{StaticResource DetailValueStyle}" />
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Quota ID" Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Subscription.QuotaId}" Style="{StaticResource DetailValueStyle}" />
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Spending limit" Style="{StaticResource DetailLabelStyle}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Subscription.SpendingLimit}" Style="{StaticResource DetailValueStyle}" />
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="State" Style="{StaticResource DetailLabelStyle}" Margin="0,0,8,0" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Subscription.State}" Style="{StaticResource DetailValueStyle}" Margin="0" />
                                </Grid>
                                <TextBlock Margin="0,12,0,0">
                                    <Hyperlink NavigateUri="{Binding Subscription.PortalUrl}" RequestNavigate="OnRequestNavigate">Open in Azure portal</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Warnings (partial failures) -->
        <Border Grid.Row="4"
                Background="#FFFBEB"
                BorderBrush="#FCD34D"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,8"
                Margin="0,12,0,0"
                Visibility="{Binding HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#92400E" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Grid.Row="5"
                Background="#FEF2F2"
                BorderBrush="#FCA5A5"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12"
                Margin="0,12,0,0"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#991B1B" />
        </Border>

        <!-- Busy overlay -->
        <Border Grid.Row="0" Grid.RowSpan="6"
                Background="#B3F4F7FB"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Background="White"
                    CornerRadius="14"
                    Padding="28,22"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel MinWidth="280">
                    <ProgressBar IsIndeterminate="True"
                                 Height="6"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="{StaticResource BorderBrush}"
                                 BorderThickness="0" />
                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</Window>
